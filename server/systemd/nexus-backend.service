[Unit]
Description=NEXUS AI Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=nexus
Group=nexus
WorkingDirectory=/opt/nexus-ai
EnvironmentFile=/opt/nexus-ai/.env
ExecStart=/opt/nexus-ai/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
# Do not expose runtimes directly — only FastAPI on localhost

[Install]
WantedBy=multi-user.target
