# NEXUS AI — Server secrets (never put these in the APK)

NEXUS_API_KEY=change-me-to-a-long-random-secret

# External APIs (optional — leave empty to disable)
# Prefer OpenRouter as a single key for OpenAI / Gemini / Claude models
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Hugging Face (for gated model downloads)
HF_TOKEN=

# Paths
LLAMA_MODEL_PATH=/opt/nexus-ai/models/llama
QWEN_MODEL_PATH=/opt/nexus-ai/models/qwen
NEXUS_DATA_DIR=./data
NEXUS_DB_PATH=./data/db/nexus.db

# Model IDs
LLAMA_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
QWEN_MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# Local runtime: auto | llama_cpp | transformers | vllm
LOCAL_RUNTIME=auto

# Resource control
MODEL_MAX_LOADED=1
MODEL_KEEP_ALIVE=false

# Context / threads / GPU layers (0 = CPU only)
LLAMA_CONTEXT=8192
QWEN_CONTEXT=8192
LLAMA_THREADS=auto
QWEN_THREADS=auto
LLAMA_GPU_LAYERS=0
QWEN_GPU_LAYERS=0

# Speech-to-text: auto | faster_whisper | none
STT_PROVIDER=auto
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Embeddings: local | none
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BYTES=20971520
REQUEST_TIMEOUT_SECONDS=300
CHAT_MAX_MESSAGES=100
CHAT_MAX_CONTENT_CHARS=100000

# Privacy defaults
MEMORY_ENABLED=true
MEMORY_ASK_BEFORE_SAVE=true
ALLOW_EXTERNAL_APIS=true
ALLOW_MEMORY_IN_EXTERNAL_APIS=false
PREFER_LOCAL_TRANSCRIPTION=true

# Logging
LOG_LEVEL=INFO
